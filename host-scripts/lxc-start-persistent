#!/usr/bin/env python3
#
# CodeLand persistent runner creator.
#
# Usage:
#   lxc-start-persistent <name> <base> [memLimit]
#
# Creates an LXC container named <name> whose entire rootfs lives on a shared
# NFS export, so it survives restarts and can move between workers. The
# rootfs is a one-time `cp -a` of the base container <base>'s rootfs onto
# NFS (see lxc-hack-clone-rootfs); after that first run, writes go straight
# to the NFS-backed rootfs and persist across stop/start/migrate with no
# extra step.
#
# This deliberately does NOT use an overlay (base rootfs as lowerdir + NFS as
# upperdir), unlike lxc-start-ephemeral. The kernel's overlayfs rejects NFS
# as an upperdir outright ("overlayfs: upper fs missing required features" --
# NFS lacks the xattr/tmpfile/RENAME_WHITEOUT support overlayfs needs from
# its upper layer), so that combination cannot work.
#
# Paths and the idmap base are configurable via environment variables.

import subprocess
import random
import re
import sys
import os

LXC_DIR = os.environ.get("LXC_DIR", "/home/virt/.local/share/lxc")
NFS_DIR = os.environ.get("NFS_DIR", "/nfs/runners")
IDMAP_BASE = int(os.environ.get("LXC_IDMAP_BASE", "165536"))
IDMAP_SIZE = int(os.environ.get("LXC_IDMAP_SIZE", "65536"))
LXC_BRIDGE = os.environ.get("LXC_BRIDGE", "lxcbr0")

config = '''
lxc.include = /usr/share/lxc/config/debian.common.conf
lxc.include = /usr/share/lxc/config/debian.userns.conf
lxc.arch = x86_64
# Container specific configuration
lxc.idmap = u 0 {idmap_base} {idmap_size}
lxc.idmap = g 0 {idmap_base} {idmap_size}
lxc.uts.name = {name}
lxc.rootfs.path = dir:{nfs_dir}/{name}/rootfs
# Network configuration
lxc.net.0.type = veth
lxc.net.0.link = {bridge}
lxc.net.0.hwaddr = {mac}
# Unprivileged users cannot create AppArmor namespaces; disable it.
lxc.apparmor.profile = unconfined
{mem_limit}
'''

pre_mount = '''#!/bin/sh
set -e
sudo /usr/local/bin/lxc-hack-clone-rootfs "{name}" "{base}"

'''


def generate_random_mac_address():
    # First byte must have the multicast bit (LSB) clear and the locally
    # administered bit set, or the kernel refuses it on the veth with
    # "Cannot assign requested address" (SIOCSIFHWADDR/EADDRNOTAVAIL) --
    # a ~50% chance failure with a fully random first byte.
    first = (random.randint(0x00, 0xFF) & 0xFE) | 0x02
    mac_bytes = [first] + [random.randint(0x00, 0xFF) for _ in range(5)]
    return ":".join("{:02x}".format(byte) for byte in mac_bytes)


def parse_mem_limit(limit):
    """Return a cgroup v2 memory.max line, or empty string if no limit."""
    if not limit:
        return ""
    if isinstance(limit, int):
        return "lxc.cgroup2.memory.max = {}".format(limit)
    if isinstance(limit, str):
        match = re.match(r"^(\d+(?:\.\d+)?)\s*([kmgt]?i?b?)$", limit.strip().lower())
        if not match:
            return ""
        value = float(match.group(1))
        unit = match.group(2)
        multiplier = {"b": 1, "kb": 1024, "mb": 1024**2, "gb": 1024**3, "tb": 1024**4}.get(unit)
        if multiplier is None:
            multiplier = {"k": 1024, "m": 1024**2, "g": 1024**3, "t": 1024**4}.get(unit, 1)
        return "lxc.cgroup2.memory.max = {}".format(int(value * multiplier))
    return ""


def run_step(description, command, **kwargs):
    """Run a subprocess step and exit(1) on failure instead of swallowing
    the error -- a silently-ignored failure here (e.g. a bad rootfs mount)
    used to surface only much later as a confusing unrelated error."""
    try:
        completed = subprocess.run(
            command, shell=True, check=True, text=True,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, **kwargs)
        if completed.stdout:
            print(completed.stdout)
        if completed.stderr:
            print(completed.stderr)
    except subprocess.CalledProcessError as e:
        print("{} failed (exit {}):".format(description, e.returncode))
        if e.stdout:
            print(e.stdout)
        if e.stderr:
            print(e.stderr)
        sys.exit(1)


if len(sys.argv) not in (3, 4):
    print("Usage: {} <name> <base> [memLimit]".format(sys.argv[0]))
    sys.exit(1)

name = sys.argv[1]
base = sys.argv[2]
mem_limit = parse_mem_limit(sys.argv[3] if len(sys.argv) == 4 else None)

directory_path = os.path.join(LXC_DIR, name)

os.makedirs(directory_path, exist_ok=True)

with open(os.path.join(directory_path, "config"), "w") as file:
    file.write(config.format(
        name=name,
        base=base,
        mac=generate_random_mac_address(),
        idmap_base=IDMAP_BASE,
        idmap_size=IDMAP_SIZE,
        nfs_dir=NFS_DIR,
        bridge=LXC_BRIDGE,
        mem_limit=mem_limit,
    ))

with open(os.path.join(directory_path, "pre-mount"), "w") as file:
    file.write(pre_mount.format(name=name, base=base))

os.chmod(os.path.join(directory_path, "pre-mount"), 0o755)

run_step("pre-mount (rootfs provisioning)", "bash pre-mount", cwd=directory_path)

run_step(
    "lxc-start",
    "~/.local/bin/lxc-start -n {} --logfile={}.log".format(name, name),
)
