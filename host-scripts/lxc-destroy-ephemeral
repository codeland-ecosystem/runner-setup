#!/bin/bash
#
# CodeLand ephemeral runner destroyer.
#
# Usage:
#   lxc-destroy-ephemeral <name>
#
# Stops the container, tears down the overlay mounts, and removes the runner.

set -uo pipefail

name="${1:?Usage: lxc-destroy-ephemeral <name>}"

# Stop and destroy may fail if the container is not running or already gone;
# that is fine (idempotent teardown), so ignore their exit codes.
lxc-stop -k -n "$name" 2>/dev/null || true
echo "lxc stop: $? on $name"

sleep 1

sudo /usr/local/bin/lxc-hack-destroy "$name" 2>/dev/null || true

lxc-destroy -f -n "$name" 2>/dev/null || true
echo "lxc destroy: $? on $name"
