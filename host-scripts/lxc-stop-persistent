#!/bin/bash
#
# CodeLand persistent runner stop.
#
# Usage:
#   lxc-stop-persistent <name>
#
# Stops a persistent runner, but KEEPS its rootfs on NFS so it can be
# restarted or moved to another worker. Only the local container directory
# (just the LXC config -- the rootfs itself lives on NFS, see
# lxc-start-persistent) is removed; the NFS state is preserved.

set -euo pipefail

name="${1:?Usage: lxc-stop-persistent <name>}"
LXC_DIR="${LXC_DIR:-/home/virt/.local/share/lxc}"

# Tolerate "already not running" -- this script is also called as
# best-effort cleanup after a container that never finished starting (e.g.
# a failed create), where lxc-stop legitimately has nothing to stop. Any
# other failure still aborts via set -e below.
lxc-stop -k -n "$name" || lxc-info -n "$name" -s 2>/dev/null | grep -q STOPPED
echo "lxc stop: $? on $name"

sleep 1

# Remove the local container directory (just the config -- the rootfs lives
# on NFS and is intentionally left in place).
rm -rf "$LXC_DIR/$name"

# Remove the leftover systemd user scope cgroup (see lxc-hack-cgroup-clean).
sudo /usr/local/bin/lxc-hack-cgroup-clean "$name" 2>/dev/null || true

echo "Persistent runner '$name' stopped; NFS state preserved."
